@startuml
skinparam classAttributeIconSize 0

class Termin {
    - dataOd: boost::posix_time::ptime
    - dataDo: boost::posix_time::ptime
    + Termin(dataOd: boost::posix_time::ptime, dataDo: boost::posix_time::ptime)
    + czyKoliduje(inny: const Termin&): bool const
    + serializuj(): string const
}

    note left of Termin
      Bezpieczeństwo terminów: Klasa Termin pełni rolę „strażnika” czasu. W przypadku próby
      utworzenia błędnego przedziału czasowego (np. data zakończenia przed datą rozpoczęcia),
      błędnych danych.
    end note

package "Hierarchia 1: Pojazdy (Polimorfizm)" {
    abstract class Pojazd {
        - nrRejestracyjny: string
        - kosztAmortyzacji: double
        + czyDostepny(okres: Termin): bool
        + zarezerwujTermin(okres: Termin): void
    }

    class Ciezarowka {
        - maksLadownoscTony: double
        - wymagaNaczepy: bool
    }

    class BusDostawczy {
        - pojemnoscM3: double
    }

    Pojazd <|-- Ciezarowka
    Pojazd <|-- BusDostawczy
}

package "Hierarchia 2: Pracownicy (Polimorfizm)" {
    abstract class Pracownik {
        - pesel: string
        - imieNazwisko: string
        - stawkaGodzinowa: double
        + czyDostepny(okres: Termin): bool
        + mozeWykonacPrace(wymaganaKat: string): bool
        + zarezerwujTermin(okres: Termin): void
    }

    class Kierowca {
        - kategoriePrawaJazdy: std::vector<std::string>
    }

    Pracownik <|-- Kierowca
}

    note bottom of "Hierarchia 2: Pracownicy (Polimorfizm)"
      Elastyczność polimorficzna: Wykorzystanie klas abstrakcyjnych Pojazd oraz Pracownik
      pozwala na łatwe rozszerzanie systemu o nowe typy zasobów (np. nowe kategorie pojazdów)
      bez konieczności modyfikacji istniejących mechanizmów. Każdy zasób samodzielnie zarządza
      swoim kalendarzem dostępności.
    end note
Zlecenie "1" *-- "1" Termin
Termin ..> InvalidTermException : «zgłasza»
@enduml